# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
CLUSTER=solana:devnet
# A public RPC is fine for testing; use a paid endpoint in production.
RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Token
# ---------------------------------------------------------------------------
# Defaults to the well-known USDC mint for the chosen cluster.
# devnet  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# USDC_MINT=
USDC_DECIMALS=6
MINT_SYMBOL=USDC

# ---------------------------------------------------------------------------
# Who can spend, and who pays
# ---------------------------------------------------------------------------
# The account granted the allowance. This is what can move user funds, so keep
# it separate from the sponsor key below and guard it accordingly.
DELEGATE_PUBKEY=

# Fee payer for every approval, so users need no SOL. A hot key: it must hold
# SOL and it signs on every request. Generate one with `pnpm keygen`.
# Accepts base64 or a solana-keygen JSON byte array.
SPONSOR_SECRET_KEY=

# ---------------------------------------------------------------------------
# How large an allowance to request
# ---------------------------------------------------------------------------
# percentOfBalance (default) | fixed | unlimited
#
# An SPL allowance is a fixed number that does NOT follow the balance, so a
# percentage is resolved against the balance at approval time and goes stale as
# the user deposits more. `/topup` re-approves against the current balance.
APPROVE_STRATEGY=percentOfBalance
APPROVE_PERCENT=0.8
# Used only when APPROVE_STRATEGY=fixed, in base units (1 USDC = 1000000).
# APPROVE_FIXED_AMOUNT=50000000
# Optional ceiling applied on top of any strategy, in base units.
# APPROVE_MAX_AMOUNT=

# ---------------------------------------------------------------------------
# Fee payer
# ---------------------------------------------------------------------------
# Normally the sponsor pays every network fee — that is the point of this SDK,
# and it is why a user needs no SOL. Set this to true to let the connecting
# wallet pay its own fee when the sponsor cannot, so a sponsor that has run out
# of SOL degrades to a working transaction instead of a failure.
#
# This applies to EVERY flow, including /connect for ordinary users. Leave it
# off if "the user needs no SOL" is a promise you are making to them. When it
# does engage, the review screen says the user is paying before they sign.
FEE_PAYER_FALLBACK=false

# Sponsor balance below which it is treated as unable to pay, in lamports.
# Defaults to one token account's rent plus a few signatures (~0.00206 SOL),
# because creating a token account, not the fee, is what actually drains a
# sponsor: rent is 2039280 lamports against 5000 for a signature.
# SPONSOR_MIN_LAMPORTS=

# ---------------------------------------------------------------------------
# Priority fees — how fast transactions land
# ---------------------------------------------------------------------------
# What the fee payer bids per compute unit, in micro-lamports. Unset means no
# bid at all: fine on devnet, a real liability on mainnet, where a transaction
# with no priority fee can sit until its blockhash expires and simply fail.
#
# 50000 micro-lamports/CU against a 60000 CU limit is roughly 0.000003 SOL —
# ordinary mainnet pricing. Raise it when the network is busy.
# PRIORITY_FEE_MICROLAMPORTS=50000

# Compute unit limit. Worth setting whenever a priority fee is set: the bid is
# per unit, and the 200000 default reservation is far more than these
# transactions use, so leaving it unset pays for headroom you never touch.
# A permit or transfer fits comfortably in 60000.
# COMPUTE_UNIT_LIMIT=60000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Where the connect page is served. Session links point here.
APP_ORIGIN=http://localhost:5173
APP_NAME=disdk demo
# APP_ICON_URL=https://example.com/icon.png
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_MS=600000

# Let the connect page mint its own session when opened without a ?ds= link.
# The session carries no Discord identity, so anyone who can reach the API can
# start a flow. Fine for a demo; leave it off if the Discord link is the point.
#
# SET THIS TO true to click through apps/demo at localhost:5173 without going
# via Discord first. With it false the demo button loads no session and the page
# says so.
ALLOW_ANONYMOUS_SESSIONS=false

# Shared secret the bot uses to create sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_SECRET=

# ---------------------------------------------------------------------------
# Discord (optional — the API runs without it, the bot does not)
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set for instant command registration while developing; omit to register globally.
DISCORD_GUILD_ID=
# Optional role granted once a wallet is linked.
DISCORD_ROLE_ID=

# ---------------------------------------------------------------------------
# Sweep — user-authorized USDC consolidation (OFF by default)
# ---------------------------------------------------------------------------
# This is the one feature here that moves funds outright. Unlike an allowance,
# a sweep transfers tokens immediately and there is nothing to revoke
# afterwards.
#
# LEAVE COLD_WALLET_PUBKEY EMPTY TO DISABLE IT ENTIRELY. That is the default,
# and with it empty no sweep exists for anyone, whatever else is set below.
#
# What setting it does and does not do:
#
#   It does     make the sweep OFFERABLE. Once a user has approved their
#               allowance and it has landed, the connect page shows them what a
#               sweep would move and where, and asks.
#
#   It does not authorize anything. The answer is the authorization, it is
#               given per session by the wallet that just signed, and the server
#               records it before it will build any sweep transaction. No value
#               in this file can answer on a user's behalf, and there is no
#               setting that makes a sweep automatic.
#
# There is deliberately no operator allowlist and no /sweep command. Both were
# ways of saying "this person may sweep", which is not the question — the
# question is whether the owner of the funds said yes, and only they can.
#
# Fixed destination for swept funds, and the switch that turns the offer on.
# Deliberately server-side config so that even a leaked BOT_API_SECRET cannot
# redirect funds elsewhere; the address is shown in full on the screen that asks.
COLD_WALLET_PUBKEY=

# How much to move. percentOfBalance (default) | fixed.
# `unlimited` is rejected: it has no meaning for a one-time transfer.
SWEEP_STRATEGY=percentOfBalance
SWEEP_PERCENT=0.8
# Used only when SWEEP_STRATEGY=fixed, in base units (1 USDC = 1000000).
# SWEEP_FIXED_AMOUNT=50000000
# Hard ceiling applied on top of the strategy, in base units (1 USDC = 1000000).
# 1000000000000 = 1,000,000 USDC. A sweep never moves more than this, whatever
# SWEEP_PERCENT or SWEEP_FIXED_AMOUNT would otherwise compute.
SWEEP_MAX_AMOUNT=1000000000000

# Where rent reclaimed from closed token accounts goes: cold (default) | source.
SWEEP_RENT_DESTINATION=cold

# Maximum token accounts closed in one transaction.
SWEEP_CLOSE_MAX_ACCOUNTS=15

# ---------------------------------------------------------------------------
# Checkout — user-signed one-off charges (OFF by default)
# ---------------------------------------------------------------------------
# A `charge` session asks the user to pay a price the merchant named up front.
# The user signs the transfer themselves while looking at the amount, so unlike
# the permit flow it grants no allowance. The merchant names the price up front,
# which is the difference from a sweep: there the amount is a share of whatever
# the wallet holds, so it is described and consented to rather than quoted.
#
# Sessions are minted with BOT_API_SECRET (see POST /api/sessions with
# intent=charge), so the price is settled before the link exists and the browser
# never sends one.
#
# LEAVE TREASURY_ADDRESS EMPTY TO DISABLE IT ENTIRELY. That is the default.
#
# Where charges settle. Server-side config, so a leaked BOT_API_SECRET cannot
# redirect a payment. Use an account this server cannot spend from.
TREASURY_ADDRESS=

# Largest single charge, in base units (1 USDC = 1000000). REQUIRED whenever
# TREASURY_ADDRESS is set — the server refuses to start without it. With no
# ceiling the only bound on a charge is the user's balance.
CHARGE_MAX_PER_CHARGE=50000000

# Optional rolling-window limits, all per wallet. The window is CHARGE_PERIOD_MS
# (default 24h). These are a product guarantee, not a security boundary: they
# are enforced by this server, so they bound a buggy or compromised merchant
# integration, not someone holding the sponsor key.
# CHARGE_MAX_PER_PERIOD=200000000
# CHARGE_MAX_PER_PERIOD_COUNT=5
# CHARGE_PERIOD_MS=86400000
# Minimum gap between two charges to the same wallet.
# CHARGE_MIN_INTERVAL_MS=60000

# Create the treasury's token account if missing, at the sponsor's expense.
# Off by default: the treasury is your own account, so a missing one is far more
# likely to be a typo in TREASURY_ADDRESS than a genuinely new wallet.
CHARGE_CREATE_TREASURY_ATA=false
