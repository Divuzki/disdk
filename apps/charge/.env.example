# ---------------------------------------------------------------------------
# The charge service
#
# This is the process that actually moves money. It is separate from
# apps/server because it is the only place the delegate SECRET key exists:
# the session server needs the delegate's public key and nothing more.
#
# Run it somewhere your users cannot reach. Only your own backend should be
# able to call it.
# ---------------------------------------------------------------------------

CLUSTER=solana:mainnet
RPC_URL=https://api.mainnet-beta.solana.com
CHARGE_PORT=8788

# Must match apps/server: the allowance is recorded per mint.
# USDC_MINT=
USDC_DECIMALS=6
MINT_SYMBOL=USDC

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------
# The delegate's secret key. Its public key is DELEGATE_PUBKEY in apps/server.
# This key can move every approved user's funds up to their allowance, so it is
# the most sensitive value in the project. Accepts base64 or a JSON byte array.
DELEGATE_SECRET_KEY=

# Where charged funds settle. Fixed here, never accepted from a caller, so a
# bug or a compromised backend cannot redirect payments. Make this an account
# this service cannot itself spend from — ideally cold storage or a multisig.
TREASURY_ADDRESS=

# Shared secret your backend sends as x-disdk-merchant-secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MERCHANT_API_SECRET=

# ---------------------------------------------------------------------------
# Terms — the limits this service enforces on itself
#
# On chain there are none: a delegate may move the entire approved amount at
# any moment. These are what make the allowance safe to grant, so set them to
# the smallest values your product actually needs.
#
# Amounts are base units. 1 USDC = 1000000.
# ---------------------------------------------------------------------------

# Largest single charge. 20 USDC.
CHARGE_MAX_PER_CHARGE=20000000

# Largest total per rolling window, and the window itself. 100 USDC per day.
CHARGE_MAX_PER_PERIOD=100000000
CHARGE_PERIOD_MS=86400000

# Cap the number of charges per window as well, so a bug that charges a tiny
# amount in a loop is bounded by count and not only by value.
CHARGE_MAX_PER_PERIOD_COUNT=10

# Minimum gap between two charges to the same wallet. 60s.
CHARGE_MIN_INTERVAL_MS=60000

# Create the treasury's token account if it is missing, at this service's
# expense. Leave false: a missing treasury account normally means TREASURY_ADDRESS
# is wrong, and you want that to fail loudly rather than be papered over.
CHARGE_CREATE_TREASURY_ATA=false
